% ------------------------------------------------------------------
% Portada (posiciones medidas en la versión Typst)
% ------------------------------------------------------------------
% \portada[subtitulo]: el subtítulo es opcional; el enunciado no lo usa y la pauta pone "Pauta".
% Si antes de cargar el documento se define \grupoenunciado (por ejemplo, compilando con
%   pdflatex "\def\grupoenunciado{3}\input{enunciado.tex}"),
% el subtítulo es "Grupo 3": así se obtiene el enunciado de un grupo sin modificar el .tex.
\newcommand\plt@texto[4]{% x, y de la línea base (desde la esquina superior izquierda), ancla, texto
  \node[anchor=#3, inner sep=0bp, outer sep=0bp] at
    ($(current page.north west)+(#1,{-(#2)})$) {#4};}
