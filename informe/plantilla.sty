\ifLuaTeX
\directlua{
  local GLYPH = node.id("glyph")
  local HLIST = node.id("hlist")
  local mayusculas = {}
  local function mayuscula(f)
    local c = mayusculas[f]
    if c == nil then
      local fuente = font.getfont(f)
      c = 0
      local datos = fuente and fuente.shared and fuente.shared.rawdata
        and fuente.shared.rawdata.metadata
      if datos and datos.units then
        local unidades = datos.capheight
        if not unidades or unidades <= 0 then unidades = datos.ascender end
        if unidades then c = unidades / datos.units * fuente.size end
      end
      if c <= 0 and fuente and fuente.characters and fuente.characters[72] then
        c = fuente.characters[72].height or 0
      end
      mayusculas[f] = c
    end
    return c
  end
  local function lineas(cabeza)
    for linea in node.traverse_id(HLIST, cabeza) do
      if linea.subtype == 1 then
        local alto, hay = 0, false
        for n in node.traverse_id(GLYPH, linea.head) do
          hay = true
          local c = mayuscula(n.font)
          if c > alto then alto = c end
        end
        if hay then
          linea.height = alto
          linea.depth = 0
        end
      end
    end
    return true
  end
  luatexbase.add_to_callback("post_linebreak_filter", lineas, "plantilla.lineas")
}
\fi

