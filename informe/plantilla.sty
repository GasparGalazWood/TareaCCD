% ------------------------------------------------------------------
% Listas
% ------------------------------------------------------------------
% (a), (b), ... para las partes; i., ii., ... para las subpartes. Las etiquetas se alinean
% a la derecha en una columna del ancho de la más ancha (opción widest de cada lista).
% Entre los elementos de una enumeración quedan 1.1em; en una lista con viñetas, solo el
% interlineado. Una lista que sigue al texto sin línea en blanco no lleva espacio antes.
\setlist{labelsep=5.5bp, parsep=6.05bp}
\setlist[enumerate]{align=right, leftmargin=*, itemsep=-1.1bp, topsep=-1.1bp, partopsep=1.1bp}
\setlist[enumerate,1]{label=(\alph*), widest=b}
\setlist[enumerate,2]{label=\roman*., widest=iii}
\setlist[enumerate,3]{label=[\Roman*], widest=III}
\setlist[itemize]{label=\textbullet, align=left, leftmargin=*, itemsep=-6.05bp, topsep=-6.05bp,
  partopsep=6.05bp}
% En LaTeX, una lista que empieza sin línea en blanco también pierde el espacio de después;
% \despueslista lo repone cuando en la versión Typst hay una línea en blanco tras la lista.
\newcommand\despueslista{\vspace{6.05bp}}

