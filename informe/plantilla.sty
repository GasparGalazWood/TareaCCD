\ifLuaTeX
\directlua{
  local GLYPH = node.id("glyph")
  local GLUE = node.id("glue")
  local KERN = node.id("kern")
  local DISC = node.id("disc")
  local PENALTY = node.id("penalty")
  local MATH = node.id("math")
  local NOAD = node.id("noad")
  local HLIST = node.id("hlist")
  local VLIST = node.id("vlist")
  local RULE = node.id("rule")
  local PARFILLSKIP = 15
  local function esletra(c)
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
      or (c >= 0xC0 and c <= 0x24F and c \string~= 0xD7 and c \string~= 0xF7)
  end
  local function letras(n, sentido)
    local c = 0
    n = n[sentido]
    while n and c < 5 do
      if n.id == GLYPH then
        local u = n.char
        if u == 0xFB03 or u == 0xFB04 then c = c + 3
        elseif u >= 0xFB00 and u <= 0xFB06 then c = c + 2
        elseif esletra(u) or u >= 0xF0000 then c = c + 1
        else break end
      elseif n.id \string~= DISC and n.id \string~= KERN then
        break
      end
      n = n[sentido]
    end
    return c
  end
  local function antes_de_cortar(cabeza)
    for d in node.traverse_id(DISC, cabeza) do
      if d.subtype == 3 then
        local pasos = math.max(0, 5 - letras(d, "prev")) + math.max(0, 5 - letras(d, "next"))
        d.penalty = math.floor(135 * (1 + 0.15 * pasos) + 10.5)
      end
    end
    local n, en_formula = node.tail(cabeza), false
    while n do
      local id = n.id
      if id == MATH then
        en_formula = (n.subtype == 1)
      elseif id == PENALTY then
        if n.penalty < 10000 then n.penalty = n.penalty + 101 break end
      elseif id == DISC and not en_formula then
        n.penalty = n.penalty + 101 break
      elseif id == GLUE and not en_formula and n.subtype \string~= PARFILLSKIP then
        local p = n.prev
        if p and (p.id == GLYPH or p.id == HLIST or p.id == VLIST or p.id == RULE
            or p.id == DISC or p.id == MATH or (p.id == KERN and p.subtype == 0)) then
          local q = node.new(PENALTY)
          q.penalty = 101
          cabeza = node.insert_before(cabeza, n, q)
          break
        end
      end
      n = n.prev
    end
    return cabeza
  end
  luatexbase.add_to_callback("pre_linebreak_filter", antes_de_cortar, "plantilla.cortes")
  local function sin_cortes_en_parentesis(cabeza, estilo, penalidades)
    if not penalidades then return cabeza end
    local nivel, n = 0, cabeza
    while n do
      if n.id == NOAD then
        local s = n.subtype
        if s == 6 then
          nivel = nivel + 1
        elseif s == 7 then
          if nivel > 0 then nivel = nivel - 1 end
        elseif (s == 4 or s == 5) and nivel > 0 and n.next and n.next.id \string~= PENALTY then
          local p = node.new(PENALTY)
          p.penalty = 10000
          cabeza, n = node.insert_after(cabeza, n, p)
        end
      end
      n = n.next
    end
    return cabeza
  end
  luatexbase.add_to_callback("pre_mlist_to_hlist_filter", sin_cortes_en_parentesis,
    "plantilla.parentesis")
}
\fi

